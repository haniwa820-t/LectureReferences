% 【追加】AGENTS.md §4.5・§4.6の形式に合わせた、この教材専用の設定。
% biblatex-japanese の標準出力と元資料形式は同じではない。
\ProvidesPackage{sample-citations}[2026/10/06 Sample report citation format]
\DeclareNameFormat{sample-author}{%
  \ifnum\value{listcount}>1\relax\printtext{・}\fi
  \namepartfamily\namepartgiven}
\DeclareFieldFormat{sample-title}{「#1」}
\DeclareFieldFormat{sample-journal}{『#1』}
\DeclareFieldFormat{sample-material}{『#1』}
\DeclareFieldFormat{sample-locator}{\mkpageprefix[pagination][\mknormrange]{#1}}
\DeclareFieldFormat{sample-pages}{#1}
\DeclareFieldFormat{sample-url}{\url{#1}}
\DeclareFieldFormat{sample-doi}{\url{https://doi.org/#1}}
\DeclareListFormat{sample-list}{#1}
\AtBeginDocument{\renewcommand*{\bibrangedash}{-}}
\newbibmacro*{sample:authors}{\printnames[sample-author]{author}\printtext{.\space}}
\newbibmacro*{sample:article}{%
  \usebibmacro{sample:authors}%
  \printfield[sample-title]{title}\printtext{.\space}%
  \printfield[sample-journal]{journaltitle}\printfield{volume}%
  \printtext{\space (}\printfield{year}\printtext{):\space}}
\newbibmacro*{sample:web}{%
  \usebibmacro{sample:authors}%
  \printfield[sample-title]{title}\printtext{.\space}%
  \printtext{『}\printlist[sample-list]{organization}\printtext{』.\space}%
  \printtext{最終アクセス}\printfield{note}\printtext{.\space}%
  \printfield[sample-url]{url}}
\DeclareCiteCommand{\sourcecite}[\mkbibfootnote]
  {}
  {\ifentrytype{article}
    {\usebibmacro{sample:article}\printfield[sample-locator]{postnote}\printtext{.}}
    {\usebibmacro{sample:web}}}
  {\multicitedelim}
  {}
\DeclareBibliographyDriver{article}{%
  \usebibmacro{sample:article}\printfield[sample-pages]{pages}%
  \printtext{.\space}\printfield[sample-doi]{doi}\usebibmacro{finentry}}
\DeclareBibliographyDriver{online}{\usebibmacro{sample:web}\usebibmacro{finentry}}
\DeclareBibliographyDriver{misc}{%
  \usebibmacro{sample:authors}\printfield[sample-material]{title}%
  \printtext{.\space}\printfield{year}\printtext{.\space （配布資料）}%
  \usebibmacro{finentry}}
\defbibenvironment{bibliography}
  {\list{}{\setlength{\leftmargin}{1\zw}\setlength{\itemindent}{-1\zw}%
    \setlength{\itemsep}{6pt}\setlength{\parsep}{0pt}}}
  {\endlist}
  {\item}
\renewcommand*{\bibfont}{\small}
\endinput
